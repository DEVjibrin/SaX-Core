# Load with: uvicorn app.main:app --env-file .env
# Leave both tokens empty only for local development.
SAX_AGENT_TOKEN=
SAX_OPERATOR_TOKEN=
SAX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAX_LEASE_TTL_S=30
SAX_BROADCAST_HZ=10
SAX_AUDIT_PATH=sax_audit.json
SAX_AUDIT_MAX_EVENTS=5000
SAX_LOG_LEVEL=INFO
